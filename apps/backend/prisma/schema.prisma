generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  subscriptionPlan String      @map("subscription_plan")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  tables           String[]    @default(["1", "2", "3"])
  presetTags       String[]    @default(["少冰", "去冰", "熱", "無糖", "微糖", "半糖", "加辣", "不加蔥", "不加香菜"])

  products         Product[]
  orders           Order[]
  shifts           Shift[]

  @@map("tenants")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineId        String?   @unique @map("line_id")
  phone         String?   @unique
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  createdAt     DateTime  @default(now()) @map("created_at")

  orders        Order[]

  @@map("users")
}

model Product {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @db.Uuid @map("tenant_id")
  name             String
  category         String      @default("未分類")
  price            Decimal     @db.Decimal(10, 2)
  imageUrl         String?     @map("image_url") // 支援 base64 或網址儲存
  isSoldOut        Boolean     @default(false) @map("is_sold_out")
  modifierTemplate Json?       @map("modifier_template")
  createdAt        DateTime    @default(now()) @map("created_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  orderItems       OrderItem[]
  recipeItems      RecipeItem[]

  @@map("products")
}


model Shift {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid @map("tenant_id")
  startTime   DateTime  @default(now()) @map("start_time")
  endTime     DateTime? @map("end_time")
  totalAmount Decimal?  @db.Decimal(10, 2) @map("total_amount")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  orders      Order[]

  @@map("shifts")
}

model Order {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @db.Uuid @map("tenant_id")
  userId       String?     @db.Uuid @map("user_id")
  status       String      @default("PENDING") // PENDING, PREPARING, COMPLETED
  orderType    String      @map("order_type")  // DINE_IN, TAKEOUT, DELIVERY
  tableNumber  String?     @map("table_number")
  totalAmount  Decimal     @db.Decimal(10, 2) @map("total_amount")
  createdAt    DateTime    @default(now()) @map("created_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  shiftId      String?     @db.Uuid @map("shift_id")
  shift        Shift?      @relation(fields: [shiftId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String  @db.Uuid @map("order_id")
  productId         String  @db.Uuid @map("product_id")
  quantity          Int
  subtotal          Decimal @db.Decimal(10, 2)
  selectedModifiers Json?   @map("selected_modifiers")

  order             Order   @relation(fields: [orderId], references: [id])
  product           Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model RawMaterial {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @db.Uuid @map("tenant_id")
  name         String
  stock        Decimal      @default(0) @db.Decimal(10, 2)
  unit         String       // e.g., 'g', 'ml', 'pcs'
  safetyStock  Decimal      @default(10) @map("safety_stock") @db.Decimal(10, 2)
  barcode      String?
  createdAt    DateTime     @default(now()) @map("created_at")

  recipeItems  RecipeItem[]

  @@map("raw_materials")
}

model RecipeItem {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String       @db.Uuid @map("product_id")
  rawMaterialId String       @db.Uuid @map("raw_material_id")
  amount        Decimal      @db.Decimal(10, 2)

  product       Product      @relation(fields: [productId], references: [id])
  rawMaterial   RawMaterial  @relation(fields: [rawMaterialId], references: [id])

  @@map("recipe_items")
}
