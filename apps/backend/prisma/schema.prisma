generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  subscriptionPlan String      @map("subscription_plan")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")

  products         Product[]
  orders           Order[]

  @@map("tenants")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineId        String?   @unique @map("line_id")
  phone         String?   @unique
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  createdAt     DateTime  @default(now()) @map("created_at")

  orders        Order[]

  @@map("users")
}

model Product {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @db.Uuid @map("tenant_id")
  name             String
  price            Decimal     @db.Decimal(10, 2)
  isSoldOut        Boolean     @default(false) @map("is_sold_out")
  modifierTemplate Json?       @map("modifier_template")

  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  orderItems       OrderItem[]

  @@map("products")
}

model Order {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @db.Uuid @map("tenant_id")
  userId       String?     @db.Uuid @map("user_id")
  status       String      @default("PENDING") // PENDING, PREPARING, COMPLETED
  orderType    String      @map("order_type")  // DINE_IN, TAKEOUT, DELIVERY
  tableNumber  String?     @map("table_number")
  totalAmount  Decimal     @db.Decimal(10, 2) @map("total_amount")
  createdAt    DateTime    @default(now()) @map("created_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String  @db.Uuid @map("order_id")
  productId         String  @db.Uuid @map("product_id")
  quantity          Int
  subtotal          Decimal @db.Decimal(10, 2)
  selectedModifiers Json?   @map("selected_modifiers")

  order             Order   @relation(fields: [orderId], references: [id])
  product           Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
